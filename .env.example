# ============================================================
# MediAssist AI Evaluation & Guardrail Pipeline
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub
# ============================================================

# ── Groq API (required) ───────────────────────────────────────
# Get from: https://console.groq.com/keys
# Model used: openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here

# ── LangSmith (required for observability) ────────────────────
# Get from: https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=mediassist-eval-pipeline

# ── Qdrant (required — MediBot vector database) ───────────────
# Default local URL — change if running on different host/port
QDRANT_URL=http://localhost:6333

# ── HuggingFace (required for embeddings) ─────────────────────
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── JWT Secret (required — must match MediBot's JWT secret) ───
# Copy exact value from MediBot's .env file
JWT_SECRET=your_jwt_secret_here

# ── MediBot API (default — change if running on different port)
MEDIBOT_URL=http://localhost:8000